# Development examples; this file contains no credentials.
# Do not commit a populated .env file.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set a unique secret before deployment:
DJANGO_SECRET_KEY=
# Set to 1 only behind a proxy that overwrites X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_HTTPS=1
# DJANGO_MEDIA_URL=https://your-media-domain.example/media/
